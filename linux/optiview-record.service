[Unit]
Description=Optiview auto-record
After=network.target local-fs.target
RequiresMountsFor=/mnt/optiview-recordings

[Service]
Type=simple
Environment=TZ=Asia/Karachi
WorkingDirectory=/opt/optiview
ExecStart=/opt/optiview/.venv/bin/python /opt/optiview/record_worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
